# ============================================================
# DJANGO CORE
# ============================================================
SECRET_KEY=your-secret-key-here-minimum-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# ============================================================
# DATABASE
# ============================================================
# PostgreSQL (production) or SQLite (development)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=sqlite:///db.sqlite3

# ============================================================
# CACHING (Redis – optional, falls back to LocMemCache)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# EMAIL (Brevo transactional HTTP API)
# ============================================================
BREVO_API_KEY=your-brevo-api-key
DEFAULT_FROM_EMAIL=info@tickflowcapital.com
DEFAULT_FROM_NAME=Tickflow Capital
CONTACT_EMAIL=info@tickflowcapital.com

# ============================================================
# EXTERNAL APIs
# ============================================================
# Finnhub (primary – 60 calls/min free tier)
FINNHUB_API_KEY=your-finnhub-api-key

# Alpha Vantage (backup – 5 calls/min)
ALPHA_VANTAGE_KEY=your-alpha-vantage-key

# Twelve Data (secondary backup – 800 calls/day)
TWELVEDATA_API_KEY=your-twelvedata-key

# RapidAPI (Yahoo Finance fallback)
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=apidojo-yahoo-finance-v1.p.rapidapi.com

# ============================================================
# MONITORING & LOGGING
# ============================================================
# Production DSN is used only when DEBUG=False (Render production).
SENTRY_DSN=
# Local DEBUG=True processes can send only to this separate development project.
# Leave blank to keep local Sentry capture disabled.
SENTRY_DEVELOPMENT_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLE_IN_DEBUG=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=1.0.0
SENTRY_SEND_PII=false
SENTRY_ATTACH_STACKTRACE=true
SENTRY_ENABLE_TRACING=true
SENTRY_ENABLE_PROFILING=false

# Logging format (true = JSON, false = human-readable)
USE_JSON_LOGS=false
LOG_LEVEL=INFO

# ============================================================
# CRON SECRET (for /stocks/cron/ endpoint)
# ============================================================
CRON_SECRET=your-long-random-cron-secret

# ============================================================
# OPTIONAL – Hugging Face token (if using gated models)
# ============================================================
HF_TOKEN=

# ============================================================
# DATABASE BACKUPS (S3)
# ============================================================
# For Neon, use the direct (non-pooler) connection string for pg_dump.
BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
BACKUP_S3_BUCKET=your-private-backup-bucket
BACKUP_S3_PREFIX=backups/
BACKUP_RETENTION_DAYS=30
BACKUP_S3_SERVER_SIDE_ENCRYPTION=AES256
# BACKUP_S3_KMS_KEY_ID=your-kms-key-id (required only when using aws:kms)
AWS_REGION=your-bucket-region
AWS_ACCESS_KEY_ID=your-backup-access-key
AWS_SECRET_ACCESS_KEY=your-backup-secret-key