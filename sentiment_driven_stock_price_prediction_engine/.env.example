# ============================================================
# DJANGO CORE
# ============================================================
SECRET_KEY=your-secret-key-here-minimum-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# ============================================================
# DATABASE
# ============================================================
# PostgreSQL (production) or SQLite (development)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=sqlite:///db.sqlite3

# ============================================================
# CACHING (Redis – optional, falls back to LocMemCache)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# EMAIL (SendGrid SMTP)
# ============================================================
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=info@tickflowcapital.com
DEFAULT_FROM_NAME=Tickflow Sentiment
CONTACT_EMAIL=info@tickflowcapital.com

# ============================================================
# EXTERNAL APIs
# ============================================================
# Finnhub (primary – 60 calls/min free tier)
FINNHUB_API_KEY=your-finnhub-api-key

# Alpha Vantage (backup – 5 calls/min)
ALPHA_VANTAGE_KEY=your-alpha-vantage-key

# Twelve Data (secondary backup – 800 calls/day)
TWELVEDATA_API_KEY=your-twelvedata-key

# RapidAPI (Yahoo Finance fallback)
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=apidojo-yahoo-finance-v1.p.rapidapi.com

# ============================================================
# MONITORING & LOGGING
# ============================================================
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=1.0.0
SENTRY_SEND_PII=true
SENTRY_ATTACH_STACKTRACE=true
SENTRY_ENABLE_TRACING=true
SENTRY_ENABLE_PROFILING=true

# Logging format (true = JSON, false = human-readable)
USE_JSON_LOGS=false
LOG_LEVEL=INFO

# ============================================================
# CRON SECRET (for /stocks/cron/ endpoint)
# ============================================================
CRON_SECRET=your-long-random-cron-secret

# ============================================================
# OPTIONAL – Hugging Face token (if using gated models)
# ============================================================
HF_TOKEN=

# ============================================================
# OPTIONAL – Database backups (if using AWS S3)
# ============================================================
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=your-backup-bucket
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret