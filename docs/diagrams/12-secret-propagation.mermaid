flowchart LR
  subgraph SOURCES["Secret sources"]
    renderEnv[Render environment]
    githubSecrets[GitHub repository secrets]
    vercelEnv[Vercel build environment]
    localEnv[Local ignored env files]
  end

  subgraph SERVER["Server-side process"]
    django[Django process]
    coreSecrets[DATABASE_URL and SECRET_KEY]
    providerMail[Market-data and email credentials]
    deployBackup[Deploy tokens and backup credentials]
  end

  subgraph CLIENT["Browser/client boundary"]
    viteBuild[Vite build]
    bundle[Public JavaScript bundle]
    jwtStore[JWT in browser storage]
    apiHeader[Authorization / X-API-Key headers]
  end

  subgraph SINKS["Potential sinks"]
    logsSentry[Logs and Sentry events]
    providers[Provider request URLs/headers]
    database[(Database)]
    s3[AWS S3]
  end

  renderEnv --> django
  django --> coreSecrets
  django --> providerMail
  githubSecrets --> deployBackup
  deployBackup -->|HTTPS deploy API| renderEnv
  deployBackup -->|HTTPS deploy API| vercelEnv
  vercelEnv --> viteBuild
  localEnv --> django
  viteBuild --> bundle
  bundle -->|Public client values| apiHeader
  jwtStore --> apiHeader
  providerMail --> providers
  providerMail -.-> logsSentry
  django --> logsSentry
  coreSecrets --> database
  deployBackup --> s3

  clientLeak[VITE_DEMO_PASSWORD if set: public bundle]
  clientKey[VITE_PUBLIC_API_KEY if set: public bundle]
  legacy[Legacy User.api_key plaintext database field]
  viteBuild --> clientLeak
  viteBuild --> clientKey
  django --> legacy
  style clientLeak fill:#fdd,stroke:#c00,color:#600
  style clientKey fill:#fdd,stroke:#c00,color:#600
  style legacy fill:#fdd,stroke:#c00,color:#600

  %% Red nodes are exposure points, not proof that a production value is currently configured.
  %% No actual secret values were read or copied.
